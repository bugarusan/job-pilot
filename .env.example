# Copy to .env, generate both values below, and keep .env private.
# POSTGRES_PASSWORD: openssl rand -hex 32
POSTGRES_PASSWORD=
# JWT_SECRET: openssl rand -base64 32
JWT_SECRET=

POSTGRES_DB=jobpilot
POSTGRES_USER=jobpilot
# JwtService expects milliseconds: 3600000 = one hour.
JWT_EXPIRATION=3600000
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
APP_IMAGE=jobpilot:local
# Development convenience. Use managed migrations and validate in production.
DDL_AUTO=update
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=60.0
